# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Session Authentication (Optional default exists)
JWT_SECRET="your-secure-random-jwt-secret-key-min-32-chars"

# Node Environment
NODE_ENV="production"

# Python Heatwave AI Service URL
AI_SERVICE_URL="http://localhost:8000"

# Google Gemini API Key for Natural Language Assistant (Optional)
GEMINI_API_KEY="your-gemini-api-key-here"

